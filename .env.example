# Required
DATABASE_URL=postgresql://user:password@host:5432/database
SECRET_KEY=replace-with-a-long-random-secret

# Browser/API security
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
SESSION_COOKIE_SECURE=true
FORCE_HSTS=0
GLOBAL_RATE_LIMIT=600
FRAUD_UI_RATE_LIMIT=240
FRAUD_WEBHOOK_RATE_LIMIT=120

# Resilience
DB_CONNECT_ATTEMPTS=3
DB_CONNECT_TIMEOUT=5

# FraudShield integrations
FRAUDSHIELD_WEBHOOK_KEY=replace-with-random-webhook-secret
FRAUDSHIELD_SOC_WEBHOOK_URL=
FRAUDSHIELD_ALLOW_OUTBOUND_WEBHOOKS=0
FINTRUST_VERIFICATION_TOKEN=replace-with-random-server-to-server-secret

# Optional AI
GEMINI_API_KEY=
